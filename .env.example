# OT Math local configuration example.
# Copy to .env only if a future provider requires local settings.

OTMATH_PROVIDER=none
OTMATH_PRIVACY_MODE=local
OTMATH_HISTORY=false
OTMATH_HISTORY_FILE=.otmath_history.jsonl
OTMATH_QUIET=false

# Optional config path override.
# OTMATH_CONFIG=

# Future cloud provider keys must be user-owned. Do not commit real keys.
# OTMATH_GEMINI_API_KEY=
# OTMATH_GROQ_API_KEY=
# OTMATH_HUGGINGFACE_API_KEY=

# Future local provider endpoint example.
# OTMATH_OLLAMA_BASE_URL=http://localhost:11434
