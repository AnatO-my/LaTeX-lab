% ============================================================
% ottensors.sty
% Tensor notation, index macros, continuum mechanics helpers
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ottensors}[2026/06/22 OT tensor macros]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{bm}

% -----------------------------
% Index notation
% -----------------------------
\newcommand{\idx}[1]{_{#1}}
\newcommand{\uind}[1]{^{#1}}
\newcommand{\partiali}[1]{\partial_{#1}}
\newcommand{\delt}[2]{\delta_{#1#2}}
\newcommand{\Delt}[2]{\delta^{#1}_{#2}}
\newcommand{\levi}[3]{\varepsilon_{#1#2#3}}

% -----------------------------
% Tensor components
% -----------------------------
\newcommand{\covcomp}[2]{#1_{#2}}
\newcommand{\concomp}[2]{#1^{#2}}
\newcommand{\mixedcomp}[3]{#1^{#2}_{\ #3}}

% -----------------------------
% Tensor operations
% -----------------------------
\newcommand{\sympart}[1]{\operatorname{sym}(#1)}
\newcommand{\skewpart}[1]{\operatorname{skw}(#1)}
\newcommand{\dev}[1]{\operatorname{dev}(#1)}
\newcommand{\sph}[1]{\operatorname{sph}(#1)}
\newcommand{\cof}[1]{\operatorname{cof}(#1)}
\newcommand{\trten}[1]{\operatorname{tr}(#1)}
\newcommand{\detten}[1]{\det(#1)}

% -----------------------------
% Symmetric / skew definitions
% -----------------------------
\newcommand{\SymDef}[1]{#1_{ij}=#1_{ji}}
\newcommand{\SkewDef}[1]{#1_{ij}=-#1_{ji}}

\newcommand{\SymPart}[1]{\frac{1}{2}\left(#1_{ij}+#1_{ji}\right)}
\newcommand{\SkewPart}[1]{\frac{1}{2}\left(#1_{ij}-#1_{ji}\right)}

% -----------------------------
% Invariants
% -----------------------------
\newcommand{\Ione}[1]{I_1(#1)=\operatorname{tr}(#1)}
\newcommand{\Itwo}[1]{I_2(#1)=\frac{1}{2}\left[(\operatorname{tr}#1)^2-\operatorname{tr}(#1^2)\right]}
\newcommand{\Ithree}[1]{I_3(#1)=\det(#1)}

\newcommand{\Jtwo}[1]{J_2(#1)=\frac{1}{2}#1'_{ij}#1'_{ij}}
\newcommand{\Jthree}[1]{J_3(#1)=\det(#1')}

% -----------------------------
% Continuum mechanics
% -----------------------------
\newcommand{\defgrad}{\mathbf{F}}
\newcommand{\rightC}{\mathbf{C}}
\newcommand{\leftB}{\mathbf{B}}
\newcommand{\GreenStrain}{\mathbf{E}}
\newcommand{\AlmansiStrain}{\mathbf{e}}
\newcommand{\CauchyStress}{\boldsymbol{\sigma}}
\newcommand{\PKone}{\mathbf{P}}
\newcommand{\PKtwo}{\mathbf{S}}

\newcommand{\DefGrad}{\mathbf{F}=\frac{\partial \mathbf{x}}{\partial \mathbf{X}}}
\newcommand{\RightCauchyGreen}{\mathbf{C}=\mathbf{F}^{\mathsf{T}}\mathbf{F}}
\newcommand{\LeftCauchyGreen}{\mathbf{B}=\mathbf{F}\mathbf{F}^{\mathsf{T}}}
\newcommand{\GreenLagrange}{\mathbf{E}=\frac{1}{2}(\mathbf{C}-\mathbf{I})}
\newcommand{\SmallStrain}{\boldsymbol{\varepsilon}=\frac{1}{2}(\nabla\mathbf{u}+(\nabla\mathbf{u})^{\mathsf{T}})}

% -----------------------------
% Stress invariants
% -----------------------------
\newcommand{\hydrostaticstress}{p=-\frac{1}{3}\sigma_{kk}}
\newcommand{\deviatoricstress}{s_{ij}=\sigma_{ij}-\frac{1}{3}\sigma_{kk}\delta_{ij}}
\newcommand{\vonmises}{\sigma_{\mathrm{vM}}=\sqrt{\frac{3}{2}s_{ij}s_{ij}}}

\endinput
