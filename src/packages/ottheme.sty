% ============================================================
% OT Theme Package (Colours and Hyperlinks)
% ottheme.sty
% Version: 0.3
% Purpose: Shared colour palette and hyperlink configuration
% ============================================================

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{ottheme}[2026/11/11 v0.3 OT Shared Theme Package]

% -----------------------------
% Required packages
% -----------------------------
% Since v0.3 the palette lives in otcolors.sty; this package is the
% compatibility facade that adds the OT hyperlink policy. Capability packages
% require otcolors only, so loading them no longer loads hyperref.
\RequirePackage{otcolors}
\RequirePackage{hyperref}

% -----------------------------
% Hyperlink policy
% -----------------------------
\hypersetup{
  colorlinks=true,
  linkcolor=OTBlue,
  urlcolor=OTBlue,
  citecolor=OTGreen
}

\endinput
