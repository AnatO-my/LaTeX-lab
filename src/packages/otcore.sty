% ============================================================
% OT Core Package
% otcore.sty
% Version: 0.3
% Purpose: Compatibility facade for shared OT class setup
% ============================================================
%
% Since v0.3 otcore is a facade (PLAN.md Phase D). Its former contents now
% live in:
%   * otcolors.sty - colour tokens (previously an unstated dependency: the
%     section styles used OTDark/OTBlue without loading them);
%   * otlayout.sty - geometry default, list defaults, running heads and
%     section styles (\otcorelistdefaults, \otcorepagestyle,
%     \otcoresectionstyles keep their names and behaviour).
% The remaining table and date packages are loaded here as before. Existing
% classes and documents see the same packages and commands.

\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{otcore}[2026/11/12 v0.3 OT Shared Core Package]

\RequirePackage{otcolors}
\RequirePackage{otlayout}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{datetime2}

\endinput
