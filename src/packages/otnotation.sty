% ============================================================
% otnotation.sty
% Consistent notation for vectors, tensors, operators, units
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{otnotation}[2026/11/12 v0.2 OT notation macros]

% Options:
%   noemphasis  do not load otemphasis (\important, \keyterm, \concept,
%               \result). Without it, otnotation loads no OT colour or
%               presentation package.
\newif\ifotnotation@emphasis\otnotation@emphasistrue
\DeclareOption{noemphasis}{\otnotation@emphasisfalse}
\ProcessOptions\relax

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{bm}
\RequirePackage{siunitx}

% -----------------------------
% Sets and fields
% -----------------------------
% Deliberate deferral: if another package already defines one of these
% names, its definition is kept.
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\Q}{\mathbb{Q}}
\providecommand{\R}{\mathbb{R}}
\providecommand{\C}{\mathbb{C}}

% -----------------------------
% Text emphasis
% -----------------------------
% Presentation helpers now live in otemphasis.sty (loaded here unless the
% noemphasis option is given).
\ifotnotation@emphasis
  \RequirePackage{otemphasis}
\fi

% -----------------------------
% Vectors, matrices, tensors
% -----------------------------
\newcommand{\vect}[1]{\boldsymbol{#1}}
\newcommand{\uvect}[1]{\hat{\boldsymbol{#1}}}
\newcommand{\mat}[1]{\mathbf{#1}}
\newcommand{\ten}[1]{\boldsymbol{\mathsf{#1}}}
\newcommand{\idten}{\ten{I}}

% Legacy alias
\newcommand{\vectorq}[1]{\vec{\mathbf{#1}}}

% -----------------------------
% Common basis vectors
% -----------------------------
\newcommand{\ihat}{\hat{\mathbf{i}}}
\newcommand{\jhat}{\hat{\mathbf{j}}}
\newcommand{\khat}{\hat{\mathbf{k}}}

\newcommand{\er}{\hat{\mathbf{e}}_r}
\newcommand{\etheta}{\hat{\mathbf{e}}_\theta}
\newcommand{\ephi}{\hat{\mathbf{e}}_\phi}
\newcommand{\erho}{\hat{\mathbf{e}}_\rho}
\newcommand{\ez}{\hat{\mathbf{e}}_z}

% -----------------------------
% Operators
% -----------------------------
% Load-order contract (docs/architecture/PLAN.md decision 8): the short names \tr, \rank,
% \dd and \grad defer to an earlier definition (the physics package defines
% all four, and wins under otscience/otbook). The \ot... names always have
% the OT meaning.
\newcommand{\ottrace}{\operatorname{tr}}
\newcommand{\otrank}{\operatorname{rank}}
\@ifundefined{tr}{\NewCommandCopy{\tr}{\ottrace}}{}
\DeclareMathOperator{\diag}{diag}
\@ifundefined{rank}{\NewCommandCopy{\rank}{\otrank}}{}
\DeclareMathOperator{\spanop}{span}
\DeclareMathOperator{\im}{Im}
\DeclareMathOperator{\kernel}{Ker}
\DeclareMathOperator{\sgn}{sgn}

% -----------------------------
% Differentials
% -----------------------------
\newcommand{\otdiff}{\,\mathrm{d}}
\@ifundefined{dd}{\NewCommandCopy{\dd}{\otdiff}}{}
\newcommand{\ddx}[1]{\frac{\mathrm{d}}{\mathrm{d}#1}}
\newcommand{\dvx}[2]{\frac{\mathrm{d}#1}{\mathrm{d}#2}}
\newcommand{\pdvx}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\pdd}[2]{\frac{\partial}{\partial #1}\left(#2\right)}
\newcommand{\otgrad}{\nabla}
\@ifundefined{grad}{\NewCommandCopy{\grad}{\otgrad}}{}
\newcommand{\lap}{\nabla^2}

% -----------------------------
% Delimiters
% -----------------------------
\newcommand{\paren}[1]{\left(#1\right)}
\newcommand{\bracket}[1]{\left[#1\right]}
\newcommand{\bracee}[1]{\left\{#1\right\}}
\newcommand{\absval}[1]{\left|#1\right|}
\newcommand{\normval}[1]{\left\lVert#1\right\rVert}
\newcommand{\otmean}[1]{\left\langle #1 \right\rangle}
\NewCommandCopy{\mean}{\otmean}

% -----------------------------
% Units and constants
% -----------------------------
% (A former \providecommand{\unit} was removed: siunitx v3, loaded above,
% always defines \unit first, so it never took effect. \unit is siunitx's.)
\newcommand{\const}{\mathrm{const.}}

\endinput
