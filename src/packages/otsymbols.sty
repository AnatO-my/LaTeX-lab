% ============================================================
% OT Symbols and Nomenclature Package
% otsymbols.sty
% Version: 0.1
% Purpose: Centralized symbol and acronym management
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{otsymbols}[2026/11/12 v0.2 OT Symbols and Nomenclature]

\RequirePackage{otcolors}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}

% Load glossaries-extra with symbols and abbreviations support
\RequirePackage[
  symbols,
  abbreviations,
  nonumberlist,
  nogroupskip
]{glossaries-extra}

% Load longtable for the nomenclature layout
\RequirePackage{longtable}
\RequirePackage{glossary-longextra}

% -----------------------------
% Global Configuration
% -----------------------------
\makeglossaries

% Store entry fields unexpanded. Fields such as user2 carry units like
% \unit{\ohm.m}; siunitx unit macros (\ohm) exist only inside \unit, so
% expanding them when the entry is defined fails with "Undefined control
% sequence".
\glsnoexpandfields

% -----------------------------
% OT Nomenclature Style
% -----------------------------
% We define a style with 4 columns: Symbol, Name, Unit, Description
\newglossarystyle{otnomenclature}{%
  \setglossarystyle{long-name-desc}%
  \renewenvironment{theglossary}%
    {\begin{longtable}{lp{0.15\textwidth}lp{0.45\textwidth}}}%
    {\end{longtable}}%
  \renewcommand*{\glossaryheader}{%
    \toprule
    \textbf{Symbol} & \textbf{Name} & \textbf{Unit} & \textbf{Description} \\
    \midrule
    \endhead
    \bottomrule
    \endfoot
  }%
  \renewcommand*{\glossentry}[2]{%
    \glstarget{##1}{\glossentryname{##1}} &
    \ifglshasfield{useri}{##1}{\glsuseri{##1}}{\ifglshaslong{##1}{\glsentrylong{##1}}{}} &
    \glsuserii{##1} &
    \glossentrydesc{##1} \\
  }%
}

% -----------------------------
% Author Interface
% -----------------------------

% \otdefinesymbol{key}{symbol}{name}{unit}{description}
\newcommand{\otdefinesymbol}[5]{%
  \glsxtrnewsymbol[
    user1={#3},
    user2={#4},
    description={#5}
  ]{#1}{\ensuremath{#2}}%
}

% \otdefineacronym{key}{short}{long}{description}
\newcommand{\otdefineacronym}[4]{%
  \newabbreviation[
    description={#4}
  ]{#1}{#2}{#3}%
}

% Wrappers for ease of use
\newcommand{\sym}[1]{\gls{#1}}
\newcommand{\acr}[1]{\gls{#1}}

% Command to print the nomenclature
\newcommand{\printotnomenclature}[1][Nomenclature]{%
  % Symbols are defined with \glsxtrnewsymbol (glossary `symbols') and
  % acronyms with \newabbreviation (glossary `abbreviations'); the main
  % glossary is empty, so print the two populated glossaries explicitly.
  \printunsrtglossary[type=symbols, style=otnomenclature, title={#1}]%
  \printunsrtglossary[type=abbreviations, style=otnomenclature, title={Abbreviations}]%
}

\endinput
