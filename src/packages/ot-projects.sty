 }
\cs_new_protected:Npn \__otp_detail:n #1
 {
   \group_begin:
   \Needspace{8\baselineskip}
   \tl_set:Nn \l__otp_current_id_tl {#1}
   \tl_set:Nx \l_tmpa_tl {\prop_item:cn {g__otp_record_#1_prop}{heading}}
   \tl_if_eq:NnTF \g__otp_style_tl {notebook}
     {\begin{otbox}[\texttt{#1}~--~\tl_use:N \l_tmpa_tl]{OTBlue}}
     {\subsection*{\texttt{#1}~--~\tl_use:N \l_tmpa_tl}}
   \__otp_anchor:n {#1}
   \__otp_field:nn {status}{Status}
   \__otp_field:nn {owner}{Owner}
   \__otp_linkfield:nn {workstream}{Workstream}
   \__otp_field:nn {date}{Date}
   \__otp_field:nn {version}{Version}
   \__otp_field:nn {role}{Role}
   \bool_if:NT \g__otp_organisations_bool
     {\__otp_field:nn {organisation}{Organisation}}
   \__otp_linkfield:nn {related}{Related~records}
   \__otp_linkfield:nn {depends-on}{Depends~on}
   \__otp_field:nn {quantity}{Quantity}
   \__otp_field:nn {unit}{Unit}
   \__otp_field:nn {supplier}{Supplier}
   \prop_get:cnN {g__otp_record_#1_prop}{unit-cost}\l__otp_value_tl
   \tl_if_blank:VF \l__otp_value_tl {\__otp_money:nn {unit-cost}{Unit~cost}}
   \str_if_eq:eeT {\prop_item:cn {g__otp_record_#1_prop}{type}}{cost}
     {
       \__otp_money:nn {planned}{Planned~line~total}
       \__otp_money:nn {actual}{Actual~line~total}
       \prop_get:cnN {g__otp_record_#1_prop}{currency}\l__otp_currency_tl
       \str_if_eq:VnF \l__otp_currency_tl {NGN}
         {
           \prop_get:cnN {g__otp_record_#1_prop}{rate}\l__otp_rate_tl
           \tl_if_blank:VTF \l__otp_rate_tl
             {\noindent\textit{Manual~exchange~rate~not~supplied;~no~NGN~conversion.}\par\smallskip}
             {
               \noindent\textbf{Manual~rate:}~NGN~\tl_use:N \l__otp_rate_tl \c_space_tl
                 per~1~\tl_use:N \l__otp_currency_tl.\par\smallskip
               \__otp_field:nn {rate-date}{Rate~date}
               \__otp_field:nn {rate-source}{Rate~source}
               \__otp_field:nn {native-planned}{Manual~planned~equivalent~(NGN)}
               \__otp_field:nn {native-actual}{Manual~actual~equivalent~(NGN)}
             }
         }
     }
   \__otp_field:nn {acceptance}{Acceptance~criteria}
   \__otp_field:nn {method}{Method}
   \__otp_field:nn {result}{Result}
   \__otp_field:nn {evidence}{Evidence}
   \__otp_field:nn {pros}{Advantages}
   \__otp_field:nn {cons}{Disadvantages}
   \__otp_field:nn {rationale}{Rationale}
   \__otp_field:nn {resolution}{Resolution}
   \__otp_field:nn {source}{Source}
   \prop_item:cn {g__otp_record_#1_prop}{body}\par
   \tl_if_eq:NnT \g__otp_style_tl {notebook}{\end{otbox}}
   \group_end:
 }
\cs_new_protected:Npn \__otp_select:nn #1#2
 {
   \prop_if_in:NnTF \g__otp_types_prop {#2}{}
     {\__otp_error:n {Unknown~record~type~'#2'.}}
   \tl_clear:N \l__otp_filter_tl
   \keys_set:nn {ot-projects/print}{#1}
   \tl_if_blank:VF \l__otp_filter_tl
     {
       \seq_if_in:NVTF \g__otp_ids_seq \l__otp_filter_tl
         {
           \str_if_eq:eeF
             {\prop_item:cn {g__otp_record_\l__otp_filter_tl _prop}{type}}{workstream}
             {\__otp_error:n {Print~filter~must~reference~a~workstream~record.}}
         }
         {\__otp_error:n {Unknown~workstream~print~filter.}}
     }
   \seq_clear:N \l__otp_selection_seq
   \seq_map_inline:Nn \g__otp_ids_seq
     {
       \str_if_eq:eeT {\prop_item:cn {g__otp_record_##1_prop}{type}}{#2}
         {
           \__otp_visible:nT {##1}
             {
               \tl_if_blank:VTF \l__otp_filter_tl
                 {\seq_put_right:Nn \l__otp_selection_seq {##1}}
                 {
                   \str_if_eq:eeT
                     {\prop_item:cn {g__otp_record_##1_prop}{workstream}}
                     {\l__otp_filter_tl}
                     {\seq_put_right:Nn \l__otp_selection_seq {##1}}
                 }
             }
         }
     }
 }
\cs_new_protected:Npn \__otp_table_row:n #1
 {
   \__otp_anchor:n {#1}\OTRecordRef{#1}
   & \prop_item:cn {g__otp_record_#1_prop}{heading}
   & \str_if_eq:eeTF {\prop_item:cn {g__otp_record_#1_prop}{type}}{person}
       {\prop_item:cn {g__otp_record_#1_prop}{category}}
       {\prop_item:cn {g__otp_record_#1_prop}{workstream}}
   & \prop_item:cn {g__otp_record_#1_prop}{status}
   \\[5pt]\hline
 }
\NewDocumentCommand \OTPrintRegister {O{} m}
 {
   \group_begin:
   \__otp_select:nn {#1}{#2}
   \seq_if_empty:NF \l__otp_selection_seq
     {
       \Needspace{8\baselineskip}
       \section*{\prop_item:Nn \g__otp_types_prop {#2}~--~register}
       \tl_clear:N \l__otp_rows_tl
       \seq_map_inline:Nn \l__otp_selection_seq
         {\tl_put_right:Nn \l__otp_rows_tl {\__otp_table_row:n {##1}}}
       \small\setlength{\LTleft}{0pt}\setlength{\LTright}{0pt}
       \begin{longtable}{@{}>{\raggedright\arraybackslash}p{.16\linewidth}
         >{\raggedright\arraybackslash}p{.43\linewidth}
         >{\raggedright\arraybackslash}p{.20\linewidth}
         >{\raggedright\arraybackslash}p{\dimexpr.21\linewidth-6\tabcolsep\relax}@{}}
       \hline\textbf{ID}&\textbf{Record}&
       \str_if_eq:nnTF {#2}{person}{\textbf{Category}}{\textbf{Workstream}}
       &\textbf{Status}\\[4pt]\hline\endhead
       \tl_use:N \l__otp_rows_tl
       \end{longtable}
     }
   \group_end:
 }
\NewDocumentCommand \OTPrintRecords {O{} m}
 {
   \group_begin:
   \__otp_select:nn {#1}{#2}
   \seq_if_empty:NF \l__otp_selection_seq
     {
       \Needspace{14\baselineskip}
       \section*{\prop_item:Nn \g__otp_types_prop {#2}}
       \str_if_eq:nnTF {#2}{person}
         {
           \clist_map_inline:nn {role,individual,organisation}
             {
               \bool_set_false:N \l_tmpa_bool
               \seq_map_inline:Nn \l__otp_selection_seq
                 {
                   \str_if_eq:eeT {\prop_item:cn {g__otp_record_####1_prop}{category}}{##1}
                     {
                       \bool_if:NF \l_tmpa_bool
                         {
                           \Needspace{12\baselineskip}
                           \str_case:nn {##1}
                             {{role}{\subsection*{Roles}}
                              {individual}{\subsection*{Individuals}}
                              {organisation}{\subsection*{Organisations}}}
                           \bool_set_true:N \l_tmpa_bool
                         }
                       \__otp_detail:n {####1}
                     }
                 }
             }
         }
         {\seq_map_inline:Nn \l__otp_selection_seq {\__otp_detail:n {##1}}}
     }
   \group_end:
 }
\NewDocumentCommand \OTPrintSignoffs {}
 {
   \group_begin:
   \__otp_select:nn {}{signatory}
   \seq_if_empty:NF \l__otp_selection_seq
     {
       \Needspace{16\baselineskip}
       \section*{Sign-off}
       \noindent These~fields~do~not~imply~approval~until~completed~by~the~named~signatory.\par
       \seq_map_inline:Nn \l__otp_selection_seq
         {
           \group_begin:
           \Needspace{12\baselineskip}
           \tl_set:Nn \l__otp_current_id_tl {##1}
           \begin{otbox}[Signatory~\texttt{##1}]{OTMuted}
           \__otp_anchor:n {##1}
