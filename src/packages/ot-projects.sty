 {
   \prop_get:cnN {g__otp_record_\l__otp_current_id_tl _prop}{#1}\l__otp_value_tl
   \clist_set:NV \l_tmpa_clist \l__otp_value_tl
   \bool_set_false:N \l_tmpa_bool
   \clist_map_inline:Nn \l_tmpa_clist
     {
       \bool_if:NT \l_tmpa_bool {,~}
       \bool_set_true:N \l_tmpa_bool
       \OTRecordRef{##1}
     }
 }
