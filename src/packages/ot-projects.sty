\cs_new_protected:Npn \__otp_add:nnnnn #1#2#3#4#5
 {
   \regex_match:nnTF {\A[A-Za-z][A-Za-z0-9-]*\Z}{#2}
     {}{\__otp_error:n {Invalid~record~ID~'#2'.~Use~letters,~digits~and~hyphens.}}
   \seq_if_in:NnTF \g__otp_ids_seq {#2}
     {\__otp_error:n {Duplicate~record~ID~'#2'.}}{}
   \group_begin:
   \prop_clear:N \l__otp_record_prop
   \clist_map_inline:nn
     {workstream,owner,status,date,source,related,depends-on,acceptance,method,
      result,evidence,pros,cons,rationale,resolution,version,category,organisation,
      role,quantity,unit,unit-cost,supplier,planned,actual,currency,rate,rate-date,
      rate-source,native-planned,native-actual,title,capacity,signature}
     {\prop_put:Nnn \l__otp_record_prop {##1}{}}
   \prop_put:Nnn \l__otp_record_prop {status}{Not~specified}
   \prop_put:Nnn \l__otp_record_prop {category}{role}
   \prop_put:Nnn \l__otp_record_prop {currency}{NGN}
   \keys_set:nn {ot-projects/record}{#4}
   \prop_put:Nnn \l__otp_record_prop {type}{#1}
   \prop_put:Nnn \l__otp_record_prop {heading}{#3}
   \prop_put:Nnn \l__otp_record_prop {body}{#5}
   \str_if_eq:nnT {#1}{person}
     {
       \prop_get:NnN \l__otp_record_prop {category}\l__otp_value_tl
       \str_case:VnF \l__otp_value_tl
         {{role}{}{individual}{}{organisation}{}}
         {\__otp_error:n {Person~'#2':~category~must~be~role,~individual~or~organisation.}}
     }
   \prop_get:NnN \l__otp_record_prop {currency}\l__otp_currency_tl
   \regex_match:nVTF {\A[A-Z]{3}\Z}\l__otp_currency_tl
     {}{\__otp_error:n {Record~'#2':~currency~must~be~three~uppercase~letters.}}
   \prop_get:NnN \l__otp_record_prop {rate}\l__otp_rate_tl
   \tl_if_blank:VF \l__otp_rate_tl
     {
       \regex_match:nVTF {\A[0-9]+(\.[0-9]+)?\Z}\l__otp_rate_tl
         {}{\__otp_error:n {Record~'#2':~manual~rate~must~be~a~positive~number.}}
       \fp_compare:nNnF {\l__otp_rate_tl}>{0}
         {\__otp_error:n {Record~'#2':~manual~rate~must~be~positive.}}
       \str_if_eq:VnT \l__otp_currency_tl {NGN}
         {\__otp_error:n {Record~'#2':~an~exchange~rate~is~only~for~foreign~currency.}}
       \clist_map_inline:nn {rate-date,rate-source}
         {
           \prop_get:NnN \l__otp_record_prop {##1}\l__otp_value_tl
           \tl_if_blank:VT \l__otp_value_tl
             {\__otp_error:n {Record~'#2':~a~manual~rate~requires~##1.}}
         }
     }
   \clist_map_inline:nn {native-planned,native-actual}
     {
       \prop_get:NnN \l__otp_record_prop {##1}\l__otp_value_tl
       \tl_if_blank:VF \l__otp_value_tl
         {
           \str_if_eq:VnTF \l__otp_currency_tl {NGN}
             {\__otp_error:n {Record~'#2':~use~planned/actual~for~native~NGN~amounts.}}
             {
               \tl_if_blank:VT \l__otp_rate_tl
                 {\__otp_error:n {Record~'#2':~a~manual~NGN~equivalent~requires~rate,~rate-date~and~rate-source.}}
             }
         }
     }
   \prop_new:c {g__otp_record_#2_prop}
   \prop_gset_eq:cN {g__otp_record_#2_prop}\l__otp_record_prop
   \seq_gput_right:Nn \g__otp_ids_seq {#2}
   \group_end:
 }
