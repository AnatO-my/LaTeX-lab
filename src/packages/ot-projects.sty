 {
   \noindent\textbf{#2:}~
   \prop_item:cn {g__otp_record_\l__otp_current_id_tl _prop}{currency}~
   \prop_get:cnN {g__otp_record_\l__otp_current_id_tl _prop}{#1}\l__otp_value_tl
