\NewDocumentCommand \OTRecordRef {m}
 {
   \seq_if_in:NnTF \g__otp_ids_seq {#1}
     {
       \__otp_visible:nTF {#1}
         {
           \cs_if_exist:cTF {r@otproject:#1}
             {\hyperref[otproject:#1]{\texttt{#1}}}
             {\texttt{#1}}
         }
         {\texttt{#1}}
     }
     {\__otp_error:n {Unknown~record~reference~'#1'.}}
 }
