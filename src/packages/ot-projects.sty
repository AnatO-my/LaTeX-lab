\cs_new_protected:Npn \__otp_validate:
 {
   \seq_map_inline:Nn \g__otp_ids_seq
     {
       \clist_map_inline:nn {related,depends-on}
         {
           \prop_get:cnN {g__otp_record_##1_prop}{####1}\l__otp_value_tl
           \clist_map_inline:Vn \l__otp_value_tl
             {
               \seq_if_in:NnTF \g__otp_ids_seq {########1}{}
                 {\__otp_error:n {Record~'##1'~references~unknown~ID~'########1'.}}
               \str_if_eq:nnT {####1}{depends-on}
                 {
                   \str_if_eq:nnT {##1}{########1}
                     {\__otp_error:n {Record~'##1'~cannot~depend~on~itself.}}
                 }
             }
         }
       \prop_get:cnN {g__otp_record_##1_prop}{workstream}\l__otp_value_tl
       \tl_if_blank:VF \l__otp_value_tl
         {
           \seq_if_in:NVTF \g__otp_ids_seq \l__otp_value_tl
             {
               \tl_set:Nx \l_tmpa_tl
                 {\prop_item:cn {g__otp_record_\l__otp_value_tl _prop}{type}}
               \str_if_eq:VnF \l_tmpa_tl {workstream}
                 {\__otp_error:n {Record~'##1':~workstream~must~reference~a~workstream~record.}}
             }
             {\__otp_error:n {Record~'##1'~has~an~unknown~workstream.}}
         }
     }
 }
\AtBeginDocument{\__otp_validate:}
\prg_new_protected_conditional:Npnn \__otp_visible:n #1 {TF,T}
 {
   \tl_set:Nx \l_tmpa_tl {\prop_item:cn {g__otp_record_#1_prop}{type}}
   \str_case:VnF \l_tmpa_tl
     {
       {person}
         {
           \tl_set:Nx \l_tmpb_tl {\prop_item:cn {g__otp_record_#1_prop}{category}}
           \str_case:Vn \l_tmpb_tl
             {
               {role}{\bool_if:NTF \g__otp_roles_bool {\prg_return_true:}{\prg_return_false:}}
               {individual}{\bool_if:NTF \g__otp_individuals_bool {\prg_return_true:}{\prg_return_false:}}
               {organisation}{\bool_if:NTF \g__otp_organisations_bool {\prg_return_true:}{\prg_return_false:}}
             }
         }
       {signatory}{\bool_if:NTF \g__otp_signoff_bool {\prg_return_true:}{\prg_return_false:}}
     }
     {\prg_return_true:}
 }
