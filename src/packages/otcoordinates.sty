% ============================================================
% otcoordinates.sty
% Coordinate systems, bases, scale factors, Jacobians
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{otcoordinates}[2026/06/22 OT coordinate macros]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{bm}

% -----------------------------
% Coordinate names
% -----------------------------
\newcommand{\cartcoords}{(x,y,z)}
\newcommand{\cylcoords}{(\rho,\phi,z)}
\newcommand{\sphcoords}{(r,\theta,\phi)}

% -----------------------------
% Bases
% -----------------------------
\newcommand{\cartbasis}{\hat{\mathbf{i}},\hat{\mathbf{j}},\hat{\mathbf{k}}}
\newcommand{\cylbasis}{\hat{\mathbf{e}}_\rho,\hat{\mathbf{e}}_\phi,\hat{\mathbf{e}}_z}
\newcommand{\sphbasis}{\hat{\mathbf{e}}_r,\hat{\mathbf{e}}_\theta,\hat{\mathbf{e}}_\phi}

% -----------------------------
% Transformations
% -----------------------------
\newcommand{\CylToCart}{
x=\rho\cos\phi,\qquad
y=\rho\sin\phi,\qquad
z=z
}

\newcommand{\CartToCyl}{
\rho=\sqrt{x^2+y^2},\qquad
\phi=\tan^{-1}\left(\frac{y}{x}\right),\qquad
z=z
}

\newcommand{\SphToCart}{
x=r\sin\theta\cos\phi,\qquad
y=r\sin\theta\sin\phi,\qquad
z=r\cos\theta
}

\newcommand{\CartToSph}{
r=\sqrt{x^2+y^2+z^2},\qquad
\theta=\cos^{-1}\left(\frac{z}{r}\right),\qquad
\phi=\tan^{-1}\left(\frac{y}{x}\right)
}

\newcommand{\SphCylRelation}{
\rho=r\sin\theta,\qquad
z=r\cos\theta,\qquad
r=\sqrt{\rho^2+z^2}
}

% -----------------------------
% Scale factors
% -----------------------------
\newcommand{\CartScale}{h_x=h_y=h_z=1}
\newcommand{\CylScale}{h_\rho=1,\qquad h_\phi=\rho,\qquad h_z=1}
\newcommand{\SphScale}{h_r=1,\qquad h_\theta=r,\qquad h_\phi=r\sin\theta}

% -----------------------------
% Line and volume elements
% -----------------------------
\newcommand{\CartLine}{ds^2=dx^2+dy^2+dz^2}
\newcommand{\CylLine}{ds^2=d\rho^2+\rho^2d\phi^2+dz^2}
\newcommand{\SphLine}{ds^2=dr^2+r^2d\theta^2+r^2\sin^2\theta\,d\phi^2}

\newcommand{\CartVol}{dV=dx\,dy\,dz}
\newcommand{\CylVol}{dV=\rho\,d\rho\,d\phi\,dz}
\newcommand{\SphVol}{dV=r^2\sin\theta\,dr\,d\theta\,d\phi}

% -----------------------------
% General orthogonal coordinates
% -----------------------------
\newcommand{\OrthGrad}[1]{
\nabla #1=
\sum_{i=1}^3
\hat{\mathbf{e}}_i
\frac{1}{h_i}
\frac{\partial #1}{\partial q^i}
}

\newcommand{\OrthDiv}{
\nabla\cdot\mathbf{A}
=
\frac{1}{h_1h_2h_3}
\left[
\frac{\partial}{\partial q^1}(h_2h_3A_1)
+
\frac{\partial}{\partial q^2}(h_3h_1A_2)
+
\frac{\partial}{\partial q^3}(h_1h_2A_3)
\right]
}

\newcommand{\OrthCurl}{
\nabla\times\mathbf{A}
=
\frac{1}{h_1h_2h_3}
\begin{vmatrix}
h_1\hat{\mathbf{e}}_1 & h_2\hat{\mathbf{e}}_2 & h_3\hat{\mathbf{e}}_3\\
\partial_{q^1} & \partial_{q^2} & \partial_{q^3}\\
h_1A_1 & h_2A_2 & h_3A_3
\end{vmatrix}
}

% -----------------------------
% Cartesian operators
% -----------------------------
\newcommand{\CartGrad}[1]{
\nabla #1=
\hat{\mathbf{i}}\frac{\partial #1}{\partial x}
+\hat{\mathbf{j}}\frac{\partial #1}{\partial y}
+\hat{\mathbf{k}}\frac{\partial #1}{\partial z}
}

\newcommand{\CartDiv}{
\nabla\cdot\mathbf{A}
=
\frac{\partial A_x}{\partial x}
+\frac{\partial A_y}{\partial y}
+\frac{\partial A_z}{\partial z}
}

% -----------------------------
% Cylindrical operators
% -----------------------------
\newcommand{\CylGrad}[1]{
\nabla #1=
\hat{\mathbf{e}}_\rho\frac{\partial #1}{\partial \rho}
+\hat{\mathbf{e}}_\phi\frac{1}{\rho}\frac{\partial #1}{\partial \phi}
+\hat{\mathbf{e}}_z\frac{\partial #1}{\partial z}
}

\newcommand{\CylDiv}{
\nabla\cdot\mathbf{A}
=
\frac{1}{\rho}\frac{\partial}{\partial \rho}(\rho A_\rho)
+\frac{1}{\rho}\frac{\partial A_\phi}{\partial \phi}
+\frac{\partial A_z}{\partial z}
}

% -----------------------------
% Spherical operators
% -----------------------------
\newcommand{\SphGrad}[1]{
\nabla #1=
\hat{\mathbf{e}}_r\frac{\partial #1}{\partial r}
+\hat{\mathbf{e}}_\theta\frac{1}{r}\frac{\partial #1}{\partial \theta}
+\hat{\mathbf{e}}_\phi\frac{1}{r\sin\theta}\frac{\partial #1}{\partial \phi}
}

\newcommand{\SphDiv}{
\nabla\cdot\mathbf{A}
=
\frac{1}{r^2}\frac{\partial}{\partial r}(r^2A_r)
+
\frac{1}{r\sin\theta}\frac{\partial}{\partial\theta}(\sin\theta A_\theta)
+
\frac{1}{r\sin\theta}\frac{\partial A_\phi}{\partial\phi}
}

% -----------------------------
% Metric
% -----------------------------
\newcommand{\metriccov}{g_{ij}=\mathbf{g}_i\cdot\mathbf{g}_j}
\newcommand{\metriccon}{g^{ij}=\mathbf{g}^i\cdot\mathbf{g}^j}
\newcommand{\reciprocalbasis}{\mathbf{g}^i\cdot\mathbf{g}_j=\delta^i_j}
\newcommand{\raiselower}{A_i=g_{ij}A^j,\qquad A^i=g^{ij}A_j}

\endinput
