% ============================================================
% otpractice.sty
% Worksheets, blanks, flashcards, exam templates
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{otpractice}[2026/11/12 v0.2 OT practice macros]

\RequirePackage{otboxes}
\RequirePackage{enumitem}

% -----------------------------
% Fill-in helpers
% -----------------------------
% Load-order contract (PLAN.md decision 8): the short names defer to an
% earlier definition (xsim, used by physicsquiz, defines \blank). The \ot...
% names always have the OT meaning.
\newcommand{\otblank}[1][3cm]{\rule{#1}{0.4pt}}
\newcommand{\otbigblank}{\rule{7cm}{0.4pt}}
\newcommand{\otlongblank}{\rule{11cm}{0.4pt}}
\newcommand{\otcomponentblank}{\rule{2.5cm}{0.4pt}}
\@ifundefined{blank}{\NewCommandCopy{\blank}{\otblank}}{}
\@ifundefined{bigblank}{\NewCommandCopy{\bigblank}{\otbigblank}}{}
\@ifundefined{longblank}{\NewCommandCopy{\longblank}{\otlongblank}}{}
\@ifundefined{componentblank}{\NewCommandCopy{\componentblank}{\otcomponentblank}}{}

% -----------------------------
% Question helpers
% -----------------------------
\newcounter{otquestion}
\newcommand{\qitem}{\stepcounter{otquestion}\noindent\textbf{Q\theotquestion.}\ }
\newcommand{\resetquestions}{\setcounter{otquestion}{0}}

\newenvironment{practice}[1][Practice]
{\begin{otscibox}[#1]{OTBlue}\resetquestions}
{\end{otscibox}}

\newenvironment{drillbox}[1][Formula Drill]
{\begin{otscibox}[#1]{OTTeal}}
{\end{otscibox}}

\newenvironment{recallbox}[1][Recall Without Looking]
{\begin{otscibox}[#1]{OTPurple}}
{\end{otscibox}}

\newenvironment{examquestion}[1][Exam Question]
{\begin{otscibox}[#1]{OTOrange}}
{\end{otscibox}}

% -----------------------------
% Worked solution template
% -----------------------------
\newcommand{\otgiven}[1]{\textbf{Given:} #1\par}
\NewCommandCopy{\given}{\otgiven}
\newcommand{\find}[1]{\textbf{Find:} #1\par}
\newcommand{\strategy}[1]{\textbf{Strategy:} #1\par}
\newcommand{\solutionstep}[1]{\textbf{Step:} #1\par}
\newcommand{\thereforeanswer}[1]{\[
    \boxed{#1}
  \]}

\newenvironment{workedsolution}[2]
{\begin{otscibox}[Worked Solution #1 (Choice #2)]{OTGreen}}
{\end{otscibox}}

% -----------------------------
% Spaced repetition card
% -----------------------------
\newtcolorbox{flashcard}[2][]{
  enhanced,
  breakable,
  colback=OTLight,
  colframe=OTGreen,
  title={Flashcard: #2},
  fonttitle=\bfseries,
  #1
}

\newcommand{\front}[1]{\textbf{Front:} #1\par}
\newcommand{\back}[1]{\textbf{Back:} #1\par}

% -----------------------------
% Exam header
% -----------------------------
\newcommand{\examheader}[4]{
  \begin{center}
    {\Large\bfseries #1}\\[2mm]
    #2\\[1mm]
    Time: #3 \qquad Marks: #4
  \end{center}
  \vspace{2mm}
  \hrule
  \vspace{4mm}
}

% -----------------------------
% Mark scheme helper
% -----------------------------
% \otmarks{<n>} prints a right-aligned "[<n> marks]" label.
% It replaces the earlier \marks{<n>}, which never worked: \marks is an e-TeX
% primitive (used by LaTeX's mark mechanism), so \providecommand left it
% untouched and \marks{4} stopped with "Missing number". The primitive must
% not be redefined, so the helper has a new, namespaced name.
\newcommand{\otmarks}[1]{\hfill\textbf{[#1 marks]}}

\endinput
