% ============================================================
% otmath.sty
% Advanced mathematics macros and theorem environments
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{otmath}[2026/11/12 v0.2 OT mathematics macros]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}
\RequirePackage{kvoptions}

% Options:
%   theorems=section|chapter  counter scope of the plain theorem environments
%   noboxes (boxes=false)     do not load otmathboxes (proofbox, identitybox);
%                             otmath then loads no OT colour or tcolorbox code
\SetupKeyvalOptions{family=OTMATH,prefix=otmath@}
\DeclareStringOption[section]{theorems}
\DeclareBoolOption[true]{boxes}
\DeclareComplementaryOption{noboxes}{boxes}
\ProcessKeyvalOptions*

% -----------------------------
% Theorem environments
% -----------------------------
\makeatletter
\def\otmath@scope{section}
\ifx\otmath@theorems\otmath@scope
  \newtheorem{otplainthm}{Theorem}[section]
\else
  \def\otmath@scope@chapter{chapter}
  \ifx\otmath@theorems\otmath@scope@chapter
    \@ifundefined{thechapter}{%
      \PackageWarning{otmath}{Chapter counter not found; falling back to section-based theorems}%
      \newtheorem{otplainthm}{Theorem}[section]
    }{%
      \newtheorem{otplainthm}{Theorem}[chapter]
    }
  \else
    \newtheorem{otplainthm}{Theorem}[section]
  \fi
\fi
\makeatother

\newtheorem{otplainlemma}[otplainthm]{Lemma}
\newtheorem{otplainprop}[otplainthm]{Proposition}
\newtheorem{otplaincor}[otplainthm]{Corollary}

\theoremstyle{definition}
\newtheorem{otplaindef}[otplainthm]{Definition}
\newtheorem{otplainex}[otplainthm]{Example}
\newtheorem{otplainexer}[otplainthm]{Exercise}
% Unboxed, theorem-numbered counterpart of otbook's boxed `designrule'
% (which has its own counter). The two are deliberately separate.
\newtheorem{otplaindesignrule}[otplainthm]{Design Rule}

% -----------------------------
% Boxed theorem-like environments
% -----------------------------
% proofbox and identitybox are presentation and live in otmathboxes.sty.
% (\makeatletter: the theorem block above ends with \makeatother.)
\makeatletter
\ifotmath@boxes
  \RequirePackage{otmathboxes}
\fi

% -----------------------------
% Algebra helpers
% -----------------------------
\newcommand{\otinverse}[1]{#1^{-1}}
\NewCommandCopy{\inv}{\otinverse}
\newcommand{\transpose}[1]{#1^{\mathsf{T}}}
\newcommand{\adj}[1]{#1^{\ast}}
\newcommand{\conj}[1]{\overline{#1}}
\newcommand{\realpart}{\operatorname{Re}}
\newcommand{\imagpart}{\operatorname{Im}}

% -----------------------------
% Calculus helpers
% -----------------------------
\newcommand{\evalat}[2]{\left.#1\right|_{#2}}
\newcommand{\limto}[2]{\lim_{#1\to #2}}
\newcommand{\series}[3]{\sum_{#1=#2}^{#3}}
\newcommand{\intab}[4]{\int_{#1}^{#2} #3\,\mathrm{d}#4}
\newcommand{\partialop}[1]{\partial_{#1}}

% -----------------------------
% Vector calculus identities
% -----------------------------
\newcommand{\gradf}[1]{\nabla #1}
\newcommand{\divv}[1]{\nabla\cdot #1}
\newcommand{\curlv}[1]{\nabla\times #1}
\newcommand{\lapf}[1]{\nabla^2 #1}

\newcommand{\dirder}[2]{D_{#1}#2}
\newcommand{\hessian}[1]{\nabla^2 #1}

% -----------------------------
% Linear algebra
% -----------------------------
\newcommand{\dotp}[2]{#1\cdot #2}
\newcommand{\crossp}[2]{#1\times #2}
\newcommand{\outerp}[2]{#1\otimes #2}
\newcommand{\doublecontract}{\mathbin{:}}
\newcommand{\innerp}[2]{\left\langle #1,#2\right\rangle}

% -----------------------------
% Common identities as display helpers
% -----------------------------
\newcommand{\curlgradzero}[1]{\nabla\times(\nabla #1)=\mathbf{0}}
\newcommand{\divcurlzero}[1]{\nabla\cdot(\nabla\times #1)=0}
\newcommand{\curlcurlid}[1]{\nabla\times(\nabla\times #1)=\nabla(\nabla\cdot #1)-\nabla^2 #1}

\endinput
