% OT Index Style File
% ============================================================

headings_flag 1
heading_prefix "{\\bfseries "
heading_suffix "}\\nopagebreak\n"

symhead_positive "Symbols"
numhead_positive "Numbers"

delim_0 ", "
delim_1 ", "
delim_2 ", "

